# FDR Sentinel environment configuration
# Copy to .env and adjust for your environment. Never commit real secrets.

APP_NAME=FDR Sentinel
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database: PostgreSQL in production; SQLite fallback for local development
# PostgreSQL example: postgresql+psycopg2://fdr_sentinel:password@localhost:5432/fdr_sentinel
DATABASE_URL=sqlite:///./fdr_sentinel.db

# Security (change these in production!)
SECRET_KEY=dev-secret-key-change-me-in-production
CSRF_SECRET_KEY=dev-csrf-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session cookie settings
SESSION_COOKIE_NAME=fdr_session
CSRF_COOKIE_NAME=fdr_csrf
COOKIE_SECURE=false          # set true when serving over HTTPS
COOKIE_SAMESITE=lax

# Document storage
STORAGE_BACKEND=local          # local | s3
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=25000000      # 25 MB
ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg

# OCR engine selection: simulated | tesseract | paddleocr
# "simulated" is a deterministic offline adapter used for tests/demos ONLY;
# it is visibly labeled synthetic and never presented as real OCR.
OCR_ENGINE=simulated
TESSERACT_CMD=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Seed development data on startup
SEED_DATA=true